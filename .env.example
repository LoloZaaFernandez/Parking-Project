# Conviene generar un valor único por instalación (ej: python -c "import secrets; print(secrets.token_hex(32))").
# Si se deja vacío, el backend genera y persiste una clave automáticamente en backend/secret_key.json.
SECRET_KEY=
RATE_PER_HOUR=2.50
# Vacío = el sistema queda esperando configuración (panel de Settings admin,
# o seteá acá una URL RTSP/MJPEG de la cámara IP, ej: rtsp://user:pass@192.168.1.10/stream1).
CAMERA_SOURCE=
CAPTURE_INTERVAL=3
MIN_CONFIDENCE=0.6
DATABASE_URL=sqlite:///./parking.db
PRINTER_NAME=
